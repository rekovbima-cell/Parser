        "url": url, "title": "", "status": "failed", "format": fmt,
        "file": None, "size_bytes": 0, "word_count": None,
        "blocked_suspected": False, "method": "playwright",
        "attempts": 0, "error": None, "elapsed_sec": 0.0,
    }
