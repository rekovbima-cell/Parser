mtExt(k){ return FORMAT_MAP[k] || k; }
function setPhase(t){ $("#phaseBadge").textContent = t; }
function setStatus(t){ $("#statusTxt").textContent = t; }

function rotateStealth(){
  const ua = pick(UA_SHORT), pair = pick(LOCALE_TZ_PAIRS), vp = pick(VIEWPORTS), node = pick(FETCH_NODES);
  $("#spUa .v").textContent = ua;
  $("#spLoc .v").textContent = pair[0] + " · " + pair[1];
  $("#spVp .v").textContent = vp;
  $("#spProxy .v").textContent = node.label;
}

/* ============================== fetch-пайплайн ============================== */
function nodeFetch(node, url, timeoutMs){
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), timeoutMs || 30000);
  return fetch(node.build(url), { signal: ctrl.signal, redirect: "follow" }).then(r => r.text().then(body => {
    clearTimeout(timer);
    if(node.json){
      let data; try{ data = JSON.parse(body); }catch(e){ throw new Error("bad json"); }
      const content = data ? data[node.contentKey] : null;
      if(typeof content !== "string" || !content.trim()) throw new Error("пустой ответ");
      return content;
    }
    if(!r.ok) throw new Error("HTTP " + r.status);
    if(!body || body.length < 200) throw new Error("пустой ответ");
    return body;
  }), e => { clearTimeout(timer); throw e; });
}

async function fetchPage(url){
  // 1) локальный render-server (PREVIEW_SERVER.py — полноценный JS-рендеринг), 2) публичные CORS-прокси
  const nodes = [RENDER_SERVER].concat(shuffle(FETCH_NODES.slice()));
  const errors = [];
  for(const node of nodes){
    try{
      log("fetch → " + node.label, "step");
      const html = await nodeFetch(node, url, node.local ? 6000 : 30000);
      return { ok:true, html:html, via:node.label };
    }catch(e){
      errors.push(node.label + ": " + String(e && e.message || e).slice(0, 90));
    }
  }
  return { ok:false, errors:errors };
}

