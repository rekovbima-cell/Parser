|| '') + '').trim().toLowerCase();
        if (!t || t.length > 40) continue;
        if (words.some(w => t === w || t.indexOf(w) === 0)) {
            try {
                const r = n.getBoundingClientRect();
                if (r.width > 0 && r.height > 0) { n.click(); clicked++; }
            } catch (e) {}
            if (clicked >= 2) break;
        }
    }
    return clicked;
}
