g:10px;font-family:var(--mono);font-size:11px;white-space:pre-wrap;word-break:break-word;margin:0 0 10px}
#pdfStage code{font-family:var(--mono);font-size:12px;background:#f2f2f2;padding:1px 4px;border-radius:4px}
#pdfStage table{border-collapse:collapse;width:100%;margin-bottom:10px;font-size:12px}
#pdfStage td,#pdfStage th{border:1px solid #ccc;padding:5px 7px;text-align:left}
#pdfStage blockquote{border-left:3px solid #bbb;margin:0 0 10px;padding:2px 0 2px 12px;color:#444}

.toast{position:fixed;right:20px;bottom:20px;z-index:99;display:flex;flex-direction:column;gap:9px;max-width:340px}
.tst{background:#161627;border:1px solid var(--line2);border-left:3px solid var(--acc);border-radius:11px;padding:11px 14px;
  font-size:12.5px;box-shadow:0 18px 40px -18px #000;animation:tstIn .3s cubic-bezier(.2,.9,.3,1.2)}
.tst.err{border-left-color:var(--err)} .tst.warn{border-left-color:var(--warn)} .tst.info{border-left-color:var(--info)}
.tst b{display:block;font-size:12px;margin-bottom:2px}
.tst span{color:var(--muted);font-family:var(--mono);font-size:11px;word-break:break-all}
@keyframes tstIn{from{opacity:0;transform:translateX(30px) scale(.96)}to{opacity:1;transform:none}}
.tst.out{animation:tstOut .3s forwards}
@keyframes tstOut{to{opacity:0;transform:translateX(30px) scale(.96)}}
</style>
</head>
<body>
<div class="bgfx"></div>

