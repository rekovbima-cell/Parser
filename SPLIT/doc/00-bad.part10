            <stop offset="0" stop-color="#00ff88"/><stop offset="1" stop-color="#00a3ff"/>
          </linearGradient>
        </defs>
        <rect x="3" y="3" width="58" height="58" rx="15" fill="#0d0d16" stroke="url(#lg)" stroke-width="1.6"/>
