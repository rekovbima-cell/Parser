ost{color:var(--txt);opacity:.85}

.mini-actions{display:flex;gap:7px;flex-wrap:wrap}
.mbtn{
  font-family:var(--sans);font-size:11.5px;font-weight:600;padding:6px 11px;border-radius:9px;cursor:pointer;
  border:1px solid var(--line2);background:#0d0d16;color:var(--muted);transition:.16s;
  display:inline-flex;align-items:center;gap:6px;
}
.mbtn:hover{color:var(--acc);border-color:rgba(0,255,136,.45);background:var(--acc-dim);transform:translateY(-1px)}
.mbtn:active{transform:translateY(0)}
.mbtn .ic{width:13px;height:13px;stroke:currentColor}

/* ---- settings grid ---- */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.field label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:6px;font-weight:600}
.field .hint{font-size:10.5px;color:var(--dim);margin-top:5px;font-family:var(--mono)}
.switch{display:flex;align-items:center;gap:10px;padding:9px 11px;border:1px solid var(--line2);border-radius:10px;background:#0d0d16;cursor:pointer;transition:.16s;user-select:none}
.switch:hover{border-color:rgba(0,255,136,.35)}
.switch.on{border-color:rgba(0,255,136,.5);background:var(--acc-dim)}
.switch input{display:none}
.track{width:36px;height:20px;border-radius:999px;background:#23233a;position:relative;transition:.2s;flex:0 0 auto}
.track::after{content:"";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#5c5c78;transition:.2s}
.switch.on .track{background:rgba(0,255,136,.3)}
.switch.on .track::after{left:18px;background:var(--acc);box-shadow:0 0 10px rgba(0,255,136,.8)}
.switch .lbl{font-size:12.5px;font-weight:600}
.switch .sub{font-size:10.5px;color:var(--dim);font-family:var(--mono)}

input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:6px;border-radius:99px;background:#23233a;outline:none;margin:14px 0 6px}
input[type=range]::-webkit-slider