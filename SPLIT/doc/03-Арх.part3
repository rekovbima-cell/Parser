hover:text-primary-700 dark:hover:text-primary-200 transition-colors">Заключение</a>
        </div>
        
        <button onclick="toggleDarkMode()" class="btn-interactive p-2 rounded-lg bg-primary-100 dark:bg-primary-800 text-primary-600 dark:text-primary-300 hover:bg-primary-200 dark:hover:bg-primary-700 transition-all">
          <i data-lucide="sun" id="sunIcon" class="w-5 h-5"></i>
          <i data-lucide="moon" id="moonIcon" class="w-5 h-5" style="display: none;"></i>
        </button>
      </div>
    </nav>
  </header>

