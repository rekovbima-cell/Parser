ite}
@keyframes shine{from{transform:translateX(-100%)}to{transform:translateX(100%)}}

/* ---- progress ---- */
.prog-top{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-bottom:9px;flex-wrap:wrap}
.prog-pct{font-family:var(--mono);font-size:30px;font-weight:700;color:var(--acc);line-height:1;text-shadow:0 0 22px rgba(0,255,136,.4)}
.prog-meta{font-family:var(--mono);font-size:11.5px;color:var(--muted);text-align:right}
.prog-meta b{color:var(--txt)}
.bar{height:12px;border-radius:99px;background:#0d0d16;border:1px solid var(--line2);overflow:hidden;position:relative}
.bar > i{display:block;height:100%;width:0%;border-radius:99px;
  background:linear-gradient(90deg,#00a35b,#00ff88,#7dffc4);
  transition:width .45s cubic-bezier(.22,.9,.28,1);position:relative}
.bar > i::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent);animation:shine 1.4s linear infinite}
.bar.err > i{background:linear-gradient(90deg,#8f1f31,#ff5470)}

/* ---- stats ---- */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(118px,1fr));gap:10px}
.stat{background:#0d0d16;border:1px solid var(--line);border-radius:12px;padding:11px 12px;position:relative;overflow:hidden;transition:.18s}
.stat:hover{border-color:var(--line2);transform:translateY(-2px)}
.stat .k{font-size:10px;text-transform:uppercase;letter-spacing:.9px;color:var(--dim);font-weight:700}
.stat .v{font-family:var(--mono);font-size:21px;font-weight:700;margin-top:3px;line-height:1.1}
.stat.ok .v{color:var(--acc)} .stat.fail .v{color:var(--err)}
.stat.block .v{color:var(--warn)} .stat.info .v{color:var(--info)}
.stat.vio .v{color:var(--violet)}
.stat::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:currentColor;opacity:.5}
.stat.ok::before{background:var(--acc)} .stat.fail::before{background:var